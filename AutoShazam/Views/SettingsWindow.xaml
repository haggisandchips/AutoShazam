<Window x:Class="AutoShazam.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Icon="/Assets/app.ico"
        Width="380" Height="630" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TitleBarForeground}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                    HorizontalAlignment="Right" Click="CloseButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TitleBarForeground}" StrokeThickness="1"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,20,24,20">
            <TextBlock Text="Microphone" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="2,0,0,6"/>
            <ComboBox ItemsSource="{Binding Microphones}"
                      SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Used for both the Shazam button and Auto Shazam listening."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="2,10,0,0"/>

            <TextBlock Text="Turn off Auto Shazam after this much silence"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="2,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="60" Text="{Binding ExtendedSilenceTimeoutSeconds, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </StackPanel>

            <TextBlock Text="Silence threshold (dBFS)"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="2,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="60" Text="{Binding SilenceThresholdDbFs, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="dBFS" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </StackPanel>
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="2,8,0,0"><Run Text="Sound below this level counts as silence. dBFS is logarithmic, so small changes"/><Run Text=" "/><Run Text="matter: less negative (e.g. -25) ignores faint background noise; more negative (e.g. -55) is more sensitive. Default -45."/></TextBlock>

            <TextBlock Text="Sound icon debounce"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="2,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="60" Text="{Binding SoundStateDebounceMs, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="ms" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </StackPanel>
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="2,8,0,0"
                       ><Run Text="This is how long a "/><Run Language="en-gb" Text="sound v silence "/><Run Text="change has to hold steady"/><Run Language="en-gb" Text=" to be recognised"/><Run Text=". Higher "/><Run Language="en-gb" Text="is more reliable but"/><Run Text=" slower"/><Run Language="en-gb" Text=" to react"/><Run Text="; lower reacts faster "/><Run Language="en-gb" Text="but more susceptible to false hits"/><Run Text=". Default 200ms."/></TextBlock>

            <TextBlock Text="Updates" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="2,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding AutomaticallyCheckForUpdates, Mode=TwoWay}"/>
                <TextBlock Text="Automatically check for updates on startup" VerticalAlignment="Center"
                           Margin="10,0,0,0" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Content="Done" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,20,0,0"
                    Padding="18,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
