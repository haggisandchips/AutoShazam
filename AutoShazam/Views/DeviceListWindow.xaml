<Window x:Class="AutoShazam.Views.DeviceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="/Assets/app.ico"
        Width="340" SizeToContent="Height" MaxHeight="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock x:Name="HeaderText" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TitleBarForeground}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                    HorizontalAlignment="Right" Click="CloseButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TitleBarForeground}" StrokeThickness="1"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOffered, Mode=TwoWay}"
                                      Foreground="{StaticResource PrimaryTextBrush}" Margin="2,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,14,0,0"
                           Text="Checked devices are offered when you right-click the icon. Leave everything unchecked to offer them all."/>

                <Button Content="Done" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,20,0,0"
                        Padding="18,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Cursor="Hand"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
