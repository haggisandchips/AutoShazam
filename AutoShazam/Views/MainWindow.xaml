<Window x:Class="AutoShazam.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AutoShazam"
        Height="640" Width="960" MinHeight="480" MinWidth="620"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="Manual">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="AutoShazam" FontWeight="SemiBold" FontSize="13"
                       Foreground="{StaticResource TitleBarForeground}"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>

            <!-- Auto Shazam toggle lives in the title bar, defaults off -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource MicIconStyle}"
                           Margin="0,0,10,0"/>
                <TextBlock Text="&#xEC4F;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource SoundLevelIconStyle}"
                           Margin="0,0,10,0"/>
                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ShazamQueryIconStyle}"
                           Margin="0,0,14,0"/>
                <TextBlock Text="Auto Shazam" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TitleBarForeground}" FontSize="12"/>
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IsAutoShazamEnabled, Mode=TwoWay}"
                              ToolTip="Automatically listen for track changes and recognize what's playing"/>
            </StackPanel>

            <Button Grid.Column="3" Style="{StaticResource TitleBarIconButtonStyle}" Click="SettingsButton_Click"
                    ToolTip="Settings" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
            </Button>

            <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"
                        ToolTip="Minimize">
                    <Path Data="M0,0 L10,0" Stroke="{StaticResource TitleBarForeground}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"
                        ToolTip="Maximize">
                    <Path x:Name="MaximizeIcon" Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="{StaticResource TitleBarForeground}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click"
                        ToolTip="Close">
                    <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TitleBarForeground}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main content: panel fills the window -->
        <Grid Grid.Row="1" Margin="24">
            <Border CornerRadius="16"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid Margin="36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Art + artist/title -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left half: square artwork, as large as fits -->
                        <Viewbox Grid.Column="0" Stretch="Uniform" Margin="0,0,24,0">
                            <Border Width="320" Height="320" CornerRadius="14" ClipToBounds="True"
                                    Background="#33353F">
                                <Grid>
                                    <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill"
                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="🎵" FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.3"
                                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                </Grid>
                            </Border>
                        </Viewbox>

                        <!-- Right half: artist / title -->
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultArtist}" FontSize="36" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding ResultTitle}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="No song identified yet" FontSize="24"
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Shazam button, centered below the art/artist/title panel -->
                    <Button Grid.Row="1" Style="{StaticResource ShazamButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,28,0,12"
                            Command="{Binding ShazamCommand}">
                        <TextBlock Text="SHAZAM" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
