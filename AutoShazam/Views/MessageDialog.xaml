<Window x:Class="AutoShazam.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="/Assets/app.ico"
        Width="380" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TitleBarForeground}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                    HorizontalAlignment="Right" Click="CloseButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TitleBarForeground}" StrokeThickness="1"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="28,20,28,20" VerticalAlignment="Center">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                       Foreground="{StaticResource PrimaryTextBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="SecondaryButton" Content="No" Click="Secondary_Click" Visibility="Collapsed"
                        Margin="0,0,10,0" Padding="18,8" Background="{StaticResource PanelBorderBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand"/>
                <Button x:Name="PrimaryButton" Content="OK" Click="Primary_Click"
                        Padding="18,8" Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
