<Window x:Class="AutoShazam.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About Auto Shazam"
        Icon="/Assets/app.ico"
        Width="340" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="About" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TitleBarForeground}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                    HorizontalAlignment="Right" Click="CloseButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TitleBarForeground}" StrokeThickness="1"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="56" Height="56" HorizontalAlignment="Center"/>
            <TextBlock Text="Auto Shazam" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock x:Name="VersionText" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock x:Name="ReleaseDateText" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

            <Button Content="Close" Click="CloseButton_Click" HorizontalAlignment="Center" Margin="0,24,0,0"
                    Padding="18,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
